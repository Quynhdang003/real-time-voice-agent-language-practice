# Copy to dograh/.env (git-ignored) before the first `docker compose -f dograh/docker-compose.yml up -d`.
# docker compose loads dograh/.env automatically because it sits next to docker-compose.yml.

# Required. Signs Dograh dashboard sessions. Generate one, e.g. in PowerShell:
#   -join ((1..48) | ForEach-Object { '{0:x}' -f (Get-Random -Maximum 16) })
DOGRAH_JWT_SECRET=

# Baked into the volumes on first start. Changing them later needs a manual migration.
DOGRAH_POSTGRES_PASSWORD=postgres
DOGRAH_REDIS_PASSWORD=redissecret
DOGRAH_MINIO_ROOT_USER=minioadmin
DOGRAH_MINIO_ROOT_PASSWORD=minioadmin

# true until the first dashboard account exists, then false (and `up -d` again).
DOGRAH_ENABLE_SIGNUP=true

# Host ports (127.0.0.1 only). If you change them, update FluentAI's .env.local
# (widget URLs and DOGRAH_TRANSCRIPT_LOCAL_ORIGINS) to match.
DOGRAH_UI_PORT=3020
DOGRAH_API_PORT=8020
DOGRAH_MINIO_PORT=9020
DOGRAH_MINIO_CONSOLE_PORT=9021

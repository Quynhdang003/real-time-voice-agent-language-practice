# FluentAI environment variables (names only). Copy to .env.local and fill in the values.
# Restart `npm run dev` after any change: Next.js reads .env.local only at startup.

# Firebase Admin (service account) — required.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Google Gemini — required for session reviews.
GOOGLE_GENERATIVE_AI_API_KEY=

# Dograh Cloud embed script per accent workflow (dograh/workflow-spec.md → Embed), copied from the
# embed dialog, e.g. https://app.dograh.com/embed/dograh-widget.js?token=<token>
# Server-only (DG-05): never use a NEXT_PUBLIC_ name, which would publish the token in the JS bundle.
# Set on Vercel too. The old NEXT_PUBLIC_DOGRAH_WIDGET_SRC* variables are no longer read; delete them.
DOGRAH_WIDGET_SRC_AMERICAN=
DOGRAH_WIDGET_SRC_BRITISH=

# Bearer token of the Dograh Webhook node credential (same value in Dograh Cloud → Credentials).
# Required on Vercel: an empty value makes the transcript webhook answer 401.
DOGRAH_WEBHOOK_SECRET=

# Transcript downloads from the retired local Dograh stack (API redirects to MinIO).
# Never set these two on Vercel; DC-02 removes them.
DOGRAH_TRANSCRIPT_MODE=local
DOGRAH_TRANSCRIPT_LOCAL_ORIGINS=http://localhost:8020,http://localhost:9020
# Public HTTPS hosts allowed for transcript downloads (set on Vercel). Default in code:
# app.dograh.com; DC-01 adds the Dograh Cloud storage host.
DOGRAH_TRANSCRIPT_ALLOWED_HOSTS=

# Dograh Cloud API for the workflow export/import scripts (npm run dograh:import / dograh:export).
# Only in .env.local; never set these on Vercel.
DOGRAH_API_BASE_URL=https://app.dograh.com
DOGRAH_API_KEY=

# Read only by getDograhRun (unused); removed in TR-01.
DOGRAH_WORKFLOW_ID=
